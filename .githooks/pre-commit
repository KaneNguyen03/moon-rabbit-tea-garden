#!/bin/bash
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -x tools/conventions.sh ] || exit 0
if git cat-file -e HEAD:tools/conventions.baseline 2>/dev/null; then
  tools/conventions.sh --since HEAD || exit 1
fi
staged=()
while IFS= read -r f; do staged+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -- 'Assets/*.cs')
[ ${#staged[@]} -eq 0 ] && exit 0
exec tools/conventions.sh "${staged[@]}"
