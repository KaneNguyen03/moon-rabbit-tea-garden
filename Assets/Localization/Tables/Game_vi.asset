    m_Localized: "M\xE9o"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593286
    m_Localized: "D\u1EBBo!"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593287
    m_Localized: "{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593288
    m_Localized: "Nh\u1ECBp {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593289
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593290
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593291
    m_Localized: "B\xE1nh xong!"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593292
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593293
    m_Localized: "{0} gi\xE3 c\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593294
    m_Localized: "Th\u1ECF B\u1EBFp b\xE1nh gi\xE3 c\xF9ng: \xD71,5"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593295
    m_Localized: "+1 c\u1ECF b\u1ED1n l\xE1 (l\u01B0\u1EE3t \u0111\u1EA7u trong ng\xE0y c\xF3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593296
    m_Localized: "+1 c\xE0 r\u1ED1t v\xE0ng (v\xE1n 3 sao \u0111\u1EA7u ng\xE0y)"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593297
    m_Localized: "Gi\xE3 b\xE1nh \xB7 c\xF2n {0} l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593298
    m_Localized: "Mai gi\xE3 ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 197531119116288
    m_Localized: "Th\u1ECF gh\xE9 ti\u1EC7m h\xF4m nay"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504896
    m_Localized: "{0} \xB7 {1} \xB7 c\xF2n {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504897
    m_Localized: "Lo\xE0i ch\u01B0a g\u1EB7p!"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504898
    m_Localized: "Mua \xB7 {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504899
    m_Localized: "C\xF2n thi\u1EBFu {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504900
    m_Localized: "\u0110\xE3 v\u1EC1 v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504901
    m_Localized: "{0} gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504902
    m_Localized: "{0} ph\xFAt"
    m_Metadata:
      m_Items: []
  - m_Id: 201923603980288
    m_Localized: "Ch\u1EEF to"
    m_Metadata:
      m_Items: []
  - m_Id: 208507595907072
    m_Localized: "H\xF4m nay v\u01B0\u1EDDn th\u01A1m qu\xE1, b\u1EA1n nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489984
    m_Localized: "Pha cho b\u1EA1n m\u1ED9t \u1EA5m tr\xE0 th\u1EADt ngon nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489985
    m_Localized: "M\u1EBB b\xE1nh n\xE0y d\xE0nh ri\xEAng cho b\u1EA1n \u0111\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489986
    m_Localized: "M\xECnh h\xE1i \u0111\u01B0\u1EE3c l\xE1 non ngon nh\u1EA5t r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489987
    m_Localized: "T\u1ED1i nay nhi\u1EC1u sao l\u1EAFm, ng\u1EAFm c\xF9ng m\xECnh kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489988
    m_Localized: "B\xE9 {0} t\u1EB7ng b\u1EA1n c\u1ECF b\u1ED1n l\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489989
    m_Localized: "\u0110\xE3 th\xE2n nhau \xB7 +{0} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 211753009930240
    m_Localized: "H\u1EE9ng l\xE1 tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513152
    m_Localized: "K\xE9o gi\u1ECF h\u1EE9ng l\xE1, n\xE9 qu\u1EA3 th\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513153
    m_Localized: "{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513154
    m_Localized: "C\xF2n {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513155
    m_Localized: +1
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513156
    m_Localized: "+2 l\xE1 v\xE0ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513157
    m_Localized: "Ui! \u22123"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513158
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513159
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513160
    m_Localized: "Gi\u1ECF \u0111\u1EA7y r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513161
    m_Localized: "H\u1EE9ng \u0111\u01B0\u1EE3c {0} l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513162
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513163
    m_Localized: "+1 c\u1ECF b\u1ED1n l\xE1 (l\u01B0\u1EE3t \u0111\u1EA7u trong ng\xE0y c\xF3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513164
    m_Localized: "H\u1EE9ng l\xE1 \xB7 c\xF2n {0} l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513165
    m_Localized: "Mai h\u1EE9ng ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513166
    m_Localized: "H\u1EE9ng l\xE1 3 sao l\u1EA7n \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513167
    m_Localized: "H\u1EE9ng l\xE1 30 v\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 212921664659456
    m_Localized: "Ch\u01B0a c\xF3 n\u01A1i l\u01B0u m\xE2y tr\xEAn b\u1EA3n n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436672
    m_Localized: "Ch\u01B0a l\u01B0u l\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436673
    m_Localized: "\u0110\xE3 l\u01B0u l\xEAn m\xE2y l\xFAc {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436674
    m_Localized: "Kh\xF4ng c\xF3 m\u1EA1ng, s\u1EBD l\u01B0u khi c\xF3 l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436675
    m_Localized: "B\u1EA3n tr\xEAn m\xE2y h\u1ECFng, \u0111\xE3 b\u1ECF qua"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436676
    m_Localized: "B\u1EA3n tr\xEAn m\xE2y t\u1EEB b\u1EA3n game m\u1EDBi h\u01A1n, \u0111\u1EC3 y\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436677
    m_Localized: "Hai b\u1EA3n kh\xE1c nhau, \u0111ang ch\u1EDD b\u1EA1n ch\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436678
    m_Localized: "L\u01B0u ngay"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436679
    m_Localized: "Kh\xF4i ph\u1EE5c t\u1EEB m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436680
    m_Localized: "Kh\xF4i ph\u1EE5c b\u1EA3n sao l\u01B0u tr\xEAn m\xE1y ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436681
    m_Localized: "\u0110\xE3 l\u1EA5y b\u1EA3n tr\xEAn m\xE2y; b\u1EA3n c\u0169 c\xF2n trong sao l\u01B0u tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436682
    m_Localized: "Gi\u1EEF b\u1EA3n tr\xEAn m\xE1y v\xE0 \u0111\xE3 l\u01B0u l\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436683
    m_Localized: "Tr\xEAn m\xE2y ch\u01B0a c\xF3 g\xEC"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436684
    m_Localized: "\u0110\xE3 l\u1EA5y l\u1EA1i b\u1EA3n sao l\u01B0u tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436685
    m_Localized: "Hai b\u1EA3n v\u01B0\u1EDDn kh\xE1c nhau"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436686
    m_Localized: "B\u1EA3n tr\xEAn m\xE2y ti\u1EBFn xa h\u01A1n. Ch\u1ECDn b\u1EA3n mu\u1ED1n gi\u1EEF; b\u1EA3n kia v\u1EABn \u0111\u01B0\u1EE3c sao l\u01B0u tr\xEAn m\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436687
    m_Localized: "B\u1EA3n tr\xEAn m\xE1y ti\u1EBFn xa h\u01A1n. Ch\u1ECDn b\u1EA3n mu\u1ED1n gi\u1EEF; b\u1EA3n kia v\u1EABn \u0111\u01B0\u1EE3c sao l\u01B0u tr\xEAn m\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436688
    m_Localized: "Tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436689
    m_Localized: "Tr\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436690
    m_Localized: "C\u1EA5p v\u01B0\u1EDDn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436691
    m_Localized: "{0} b\xE9 th\u1ECF \xB7 {1} lo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436692
    m_Localized: "\u0110\xE3 ch\u01A1i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436693
    m_Localized: "L\u1EA7n cu\u1ED1i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436694
    m_Localized: "G\u1EE3i \xFD"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436695
    m_Localized: "Gi\u1EEF b\u1EA3n tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436696
    m_Localized: "L\u1EA5y b\u1EA3n tr\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 216545128079360
    m_Localized: "\u0110\xEAm \u0111om \u0111\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439488
    m_Localized: "Ch\u1EA1m \u0111\u1EC3 b\u1EAFt \u0111om \u0111\xF3m bay qua v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439489
    m_Localized: "{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439490
    m_Localized: "C\xF2n {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439491
    m_Localized: +1
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439492
    m_Localized: "+3 v\xE0ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439493
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439494
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439495
    m_Localized: "L\u1ECD s\xE1ng r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439496
    m_Localized: "B\u1EAFt \u0111\u01B0\u1EE3c {0} con"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439497
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439498
    m_Localized: "+{0} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439499
    m_Localized: "+1 c\xE0 r\u1ED1t v\xE0ng (3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439500
    m_Localized: "\u0110\xE3 t\u1EDBi tr\u1EA7n h\xF4m nay, mai th\u01B0\u1EDFng ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439501
    m_Localized: "\u0110om \u0111\xF3m \xB7 c\xF2n {0} l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439502
    m_Localized: "Mai b\u1EAFt ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439503
    m_Localized: "B\u1EAFt \u0111om \u0111\xF3m 3 sao l\u1EA7n \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439504
    m_Localized: "B\u1EAFt \u0111om \u0111\xF3m 30 \u0111\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 218048119169024
    m_Localized: "Kh\xE1ch \u0111\u1EB7t tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751936
    m_Localized: "Kh\xE1ch!"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751937
    m_Localized: "{0} gh\xE9 qu\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751938
    m_Localized: "Mu\u1ED1n mua"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751939
    m_Localized: "Ch\u1EDD th\xEAm {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751940
    m_Localized: "Giao \u0111\u1EE7: +{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751941
    m_Localized: "Giao \u0111\u1EE7: +{0} c\xE0 r\u1ED1t \xB7 +1 c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751942
    m_Localized: Giao
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751943
    m_Localized: "C\xF2n thi\u1EBFu {0} m\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751944
    m_Localized: "Kh\xE1ch h\xE0i l\xF2ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751945
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751946
    m_Localized: "+{0} c\xE0 r\u1ED1t \xB7 +1 c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751947
    m_Localized: "Kh\xE1ch \u0111\xE3 \u0111i"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751948
    m_Localized: "Giao 2 \u0111\u01A1n tr\xE0 cho kh\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751949
    m_Localized: "Giao 20 \u0111\u01A1n tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 219281773027328
    m_Localized: "Tr\u1EA1m l\xEAn b\u1EADc {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 219281785610240
    m_Localized: "{0} \xB7 c\u1EA5p {1}, gi\u1EDD thu g\u1EA5p \u0111\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 224994255691776
    m_Localized: "Ch\u1EC9 \u0111\u1EC3 \u0111\u1EB9p"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663296
    m_Localized: "N\xF3n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663297
    m_Localized: "V\xF2ng hoa t\u01B0\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663298
    m_Localized: "M\u0169 len"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663299
    m_Localized: "N\u01A1 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663300
    m_Localized: "M\u0169 sao"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663301
    m_Localized: "V\u01B0\u01A1ng mi\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857600
    m_Localized: "\u0110\u1ED3 cho th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857601
    m_Localized: "M\u0169 ch\u1EC9 \u0111\u1EC3 \u0111\u1EB9p, \u0111\u1ED9i gi\u1EEFa hai tai \xB7 m\u1ED7i lo\u1EA1i m\u1ED9t chi\u1EBFc \xB7 nhu\u1ED9m l\xF4ng \u1EDF t\u1EA5m c\u1EE7a t\u1EEBng b\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857602
    m_Localized: "\u0110\xE3 c\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857603
    m_Localized: "Ch\u1EA1m l\u1EA7n n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857604
    m_Localized: "{0} \u0111\xE3 v\u1EC1 t\u1EE7 \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857605
    m_Localized: "Nhu\u1ED9m l\xF4ng \xB7 {0} c\xE0 r\u1ED1t v\xE0ng m\u1ED7i l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857606
    m_Localized: "Nhu\u1ED9m l\xF4ng \xB7 {0} c\xE0 r\u1ED1t v\xE0ng \xB7 C\xF2n thi\u1EBFu"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857607
    m_Localized: "G\u1ED9i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857608
    m_Localized: "\u0110\xE3 nhu\u1ED9m {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857609
    m_Localized: "h\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857610
    m_Localized: "\u0111\xE0o"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857611
    m_Localized: "v\xE0ng chanh"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857612
    m_Localized: "b\u1EA1c h\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857613
    m_Localized: "xanh tr\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857614
    m_Localized: "o\u1EA3i h\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857615
    m_Localized: kem
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857616
    m_Localized: than
    m_Metadata:
      m_Items: []
  - m_Id: 249588253450240
    m_Localized: "Quy\u1EC1n ri\xEAng t\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838848
    m_Localized: "\u0110\u1ECDc ch\xEDnh s\xE1ch quy\u1EC1n ri\xEAng t\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838849
    m_Localized: "C\u1EA7n gi\xFAp? G\u1EEDi m\xE3 ng\u01B0\u1EDDi ch\u01A1i t\u1EDBi {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838850
    m_Localized: "Xo\xE1 d\u1EEF li\u1EC7u c\u1EE7a t\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838851
    m_Localized: "Ch\u1EA1m l\u1EA7n n\u1EEFa: xo\xE1 v\u01B0\u1EDDn, sao l\u01B0u v\xE0 b\u1EA3n tr\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838852
    m_Localized: "Kh\xF4ng ho\xE0n t\xE1c \u0111\u01B0\u1EE3c. Ch\u1EA1m l\u1EA7n cu\u1ED1i \u0111\u1EC3 xo\xE1 h\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838853
    m_Localized: "\u0110\xE3 xo\xE1 h\u1EBFt d\u1EEF li\u1EC7u; v\u01B0\u1EDDn b\u1EAFt \u0111\u1EA7u l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838854
    m_Localized: "\u0110\xE3 xo\xE1 tr\xEAn m\xE1y; b\u1EA3n tr\xEAn m\xE2y kh\xF4ng xo\xE1 \u0111\u01B0\u1EE3c, th\u1EED l\u1EA1i khi c\xF3 m\u1EA1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 251714404868096
    m_Localized: "Th\u1ECF \u0110\xE8n \xD4ng Sao"
    m_Metadata:
      m_Items: []
  - m_Id: 251714413256704
    m_Localized: "Th\u1ECF \xC1o D\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 251714413256705
    m_Localized: "Th\u1ECF Noel"
    m_Metadata:
      m_Items: []
  - m_Id: 252465726349312
    m_Localized: "G\u1EB7p Th\u1ECF \u0110\xE8n \xD4ng Sao"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320832
    m_Localized: "X\u1EBFp Th\u1ECF \u0110\xE8n \xD4ng Sao v\xE0o \u0111\xFAng ngh\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320833
    m_Localized: "Ch\u1EE5p \u1EA3nh c\xF3 Th\u1ECF \u0110\xE8n \xD4ng Sao"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320834
    m_Localized: "G\u1EB7p Th\u1ECF \xC1o D\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320835
    m_Localized: "X\u1EBFp Th\u1ECF \xC1o D\xE0i v\xE0o \u0111\xFAng ngh\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320836
    m_Localized: "Ch\u1EE5p \u1EA3nh c\xF3 Th\u1ECF \xC1o D\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320837
    m_Localized: "G\u1EB7p Th\u1ECF Noel"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320838
    m_Localized: "X\u1EBFp Th\u1ECF Noel v\xE0o \u0111\xFAng ngh\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320839
    m_Localized: "Ch\u1EE5p \u1EA3nh c\xF3 Th\u1ECF Noel"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320840
    m_Localized: Trung thu
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320841
    m_Localized: "T\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320842
    m_Localized: "Gi\xE1ng sinh"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320843
    m_Localized: "Th\u1ECF d\u1ECBp \u0111\u1EB7c bi\u1EC7t \xB7 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320844
    m_Localized: "Ch\u1EC9 c\xF3 trong {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320845
    m_Localized: "Ch\u1EC9 trong m\xF9a; h\u1EBFt m\xF9a th\xEC m\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 256349303726080
    m_Localized: "Trang tr\xED v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891904
    m_Localized: "\u0110\xE3 c\xF3 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891905
    m_Localized: "H\u1EBFt ch\u1ED7"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891906
    m_Localized: "M\xE0u \u0111\xE8n l\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891907
    m_Localized: "\u0110\xE8n \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891908
    m_Localized: "B\u1ED3n hoa"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891909
    m_Localized: "Gh\u1EBF n\u1EA5m"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891910
    m_Localized: "Th\u1EA3m picnic"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891911
    m_Localized: "gi\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891912
    m_Localized: "h\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891913
    m_Localized: "b\u1EA1c h\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891914
    m_Localized: "o\u1EA3i h\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891915
    m_Localized: "Trang tr\xED ch\u1ED7 n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891916
    m_Localized: "\u0110\u1ED3 mua \u1EDF ti\u1EC7m tr\xE0, \u0111ang \u0111\u1EC3 trong kho"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891917
    m_Localized: "\u0110ang \u0111\u1EB7t: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891918
    m_Localized: "Ch\u1ED7 c\xF2n tr\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891919
    m_Localized: 'Trong kho: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891920
    m_Localized: "Kh\xF4ng c\xF3 trong kho"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891921
    m_Localized: "\u0110\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891922
    m_Localized: "\u0110\u1ED5i"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891923
    m_Localized: "C\u1EA5t v\xE0o kho"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891924
    m_Localized: "{0} \u0111\xE3 v\u1EC1 kho \xB7 ch\u1EA1m ch\u1ED7 + trong v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891925
    m_Localized: "\u0110\xE8n l\u1ED3ng m\xE0u {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 257877154455552
    m_Localized: "M\xF9a {0} \u0111\xE3 v\u1EC1!"
    m_Metadata:
      m_Items: []
  - m_Id: 257877167038464
    m_Localized: "{0} gh\xE9 ti\u1EC7m, c\xF3 th\u1EC3 ra t\u1EEB G\u1ECDi v\xE0ng v\xE0 \u0111\u1EBFn l\xE0m qu\xE0 ng\xE0y cu\u1ED1i m\xF9a"
    m_Metadata:
      m_Items: []
  - m_Id: 265567842852864
    m_Localized: "\u0110ang li\xEAn k\u1EBFt {0}\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824384
    m_Localized: "Ch\u01B0a li\xEAn k\u1EBFt \u0111\u01B0\u1EE3c {0}; ch\u1EA1m n\xFAt \u0111\u1EC3 th\u1EED l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824385
    m_Localized: Game Center
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824386
    m_Localized: Google Play Games
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824387
    m_Localized: Apple
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824388
    m_Localized: Google
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824389
    m_Localized: "\u0110\u0103ng nh\u1EADp iCloud trong C\xE0i \u0111\u1EB7t c\u1EE7a m\xE1y \u0111\u1EC3 l\u01B0u l\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 265567863824390
    m_Localized: "B\u1EA3n l\u01B0u qu\xE1 l\u1EDBn cho iCloud, ch\u01B0a g\u1EEDi l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 270018389467136
    m_Localized: "M\xF9a tr\u0103ng m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827264
    m_Localized: "\u0110\u1EE7 c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827265
    m_Localized: "M\xF9a tr\u0103ng m\u1EDBi m\u1EDF \u1EDF c\u1EA5p v\u01B0\u1EDDn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827266
    m_Localized: "\u0110\xE3 qua \u0111\u1EE7 b\u1EA3y m\xF9a tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827267
    m_Localized: "M\xF9a tr\u0103ng m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827268
    m_Localized: "V\u01B0\u1EDDn v\u1EC1 b\u1ED1n \xF4 \u0111\u1EA5t \u0111\u1EA7u ti\xEAn. Th\u1ECF v\xE0 \u0111\u1ED3 \u1EDF l\u1EA1i, thu nh\u1EADp t\u0103ng m\xE3i m\xE3i."
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827269
    m_Localized: "Gi\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827270
    m_Localized: "{0} b\xE9 th\u1ECF, {1} v\u1EADt ph\u1EA9m, {2} c\xE0 r\u1ED1t v\xE0ng, {3} c\u1ECF b\u1ED1n l\xE1\nS\u1ED5 th\u1ECF, \u1EA3nh, th\xE0nh t\u1EF1u, h\u1ED3 s\u01A1 v\xE0 c\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827271
    m_Localized: "V\u1EC1 \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827272
    m_Localized: "{0} c\xE0 r\u1ED1t \xB7 {1} c\u1EA5p tr\u1EA1m \u1EDF {2} tr\u1EA1m\n\xD4 \u0111\u1EA5t {3} \u2192 {4} \xB7 ch\u1ED7 ngh\u1EC9 {5} \u2192 {6} \xB7 c\u1EA5p v\u01B0\u1EDDn {7} \u2192 1"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827273
    m_Localized: "\u0110\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827274
    m_Localized: "Thu nh\u1EADp +{0}% \u2192 +{1}% m\xE3i m\xE3i\n+{2} c\u1ECF b\u1ED1n l\xE1 \xB7 +{3} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827275
    m_Localized: " \xB7 Th\u1ECF Tr\u0103ng Non"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827276
    m_Localized: "Gi\u1EEF 1,5 gi\xE2y \u0111\u1EC3 m\u1EDF kho\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827277
    m_Localized: "Ch\u1EA1m l\u1EA7n n\u1EEFa \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u Tr\u0103ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827278
    m_Localized: "\u0110\u1EC3 sau"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827279
    m_Localized: "Tr\u0103ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827280
    m_Localized: "Tr\u0103ng l\u1EB7n r\u1ED3i m\u1ECDc l\u1EA1i tr\xEAn v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827281
    m_Localized: "Ch\u1EA1m \u0111\u1EC3 b\u1ECF qua"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827282
    m_Localized: "Tr\u0103ng {0} b\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827283
    m_Localized: "Thu nh\u1EADp +{0}% m\xE3i m\xE3i \xB7 +{1} c\u1ECF b\u1ED1n l\xE1 \xB7 +{2} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827284
    m_Localized: "Tr\u0103ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827285
    m_Localized: "C\u1EA5p v\u01B0\u1EDDn {0} \xB7 {1} b\xE9 th\u1ECF \xB7 {2} tr\u1EA1m \xB7 Tr\u0103ng {3}, thu nh\u1EADp +{4}%"
    m_Metadata:
      m_Items: []
  - m_Id: 270018418827286
    m_Localized: "Ch\u1EC9 \u0111\u1EBFn c\xF9ng M\xF9a tr\u0103ng m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 270018427215872
    m_Localized: "Th\u1ECF Tr\u0103ng Non"
    m_Metadata:
      m_Items: []
  - m_Id: 272084788830208
    m_Localized: Google Play Games
    m_Metadata:
      m_Items: []
  - m_Id: 272084809801728
    m_Localized: "Saved Games c\u1EE7a Google Play"
    m_Metadata:
      m_Items: []
  - m_Id: 272084809801729
    m_Localized: "C\u1EA5p v\u01B0\u1EDDn {0} \xB7 {1} th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 272084809801730
    m_Localized: "B\u1EA3n l\u01B0u qu\xE1 3 MB n\xEAn Saved Games kh\xF4ng nh\u1EADn; v\u01B0\u1EDDn v\u1EABn c\xF2n tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 273544201101312
    m_Localized: "Mua th\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878528
    m_Localized: "Mua c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878529
    m_Localized: "C\xE0 r\u1ED1t v\xE0ng d\xF9ng \u1EDF Ti\u1EC7m: g\u1ECDi v\xE0ng, th\u1ECF gh\xE9, m\u0169, trang tr\xED. T\u1EC9 l\u1EC7 g\u1ECDi ghi ngay \u1EDF Ti\u1EC7m; kh\xF4ng c\xF3 g\xEC kh\xE1c mua b\u1EB1ng ti\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878530
    m_Localized: "{0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878531
    m_Localized: "H\u1EDDi nh\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878532
    m_Localized: "\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878533
    m_Localized: "\u0110ang m\u1EDF c\u1EEDa h\xE0ng\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878534
    m_Localized: "\u0110\xE3 c\u1ED9ng {0} c\xE0 r\u1ED1t v\xE0ng. C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 \u1EE7ng h\u1ED9 v\u01B0\u1EDDn tr\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878535
    m_Localized: "\u0110\xE3 hu\u1EF7, kh\xF4ng m\u1EA5t g\xEC"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878536
    m_Localized: "Mua kh\xF4ng th\xE0nh c\xF4ng, th\u1EED l\u1EA1i sau"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878537
    m_Localized: "G\xF3i n\xE0y \u0111\xE3 \u0111\u01B0\u1EE3c c\u1ED9ng t\u1EEB tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878538
    m_Localized: "C\u1EEDa h\xE0ng ch\u01B0a s\u1EB5n s\xE0ng tr\xEAn m\xE1y n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878539
    m_Localized: "Kh\xF4i ph\u1EE5c giao d\u1ECBch"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878540
    m_Localized: "\u0110ang h\u1ECFi c\u1EEDa h\xE0ng\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878541
    m_Localized: "\u0110\xE3 ki\u1EC3m tra v\u1EDBi c\u1EEDa h\xE0ng; g\xF3i n\xE0o c\xF2n thi\u1EBFu s\u1EBD \u0111\u01B0\u1EE3c c\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878542
    m_Localized: "Kh\xF4ng h\u1ECFi \u0111\u01B0\u1EE3c c\u1EEDa h\xE0ng, th\u1EED l\u1EA1i sau"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878543
    m_Localized: "\u0110\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 273544217878544
    m_Localized: "+{0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 340555539144704
    m_Localized: "Khay: th\xEAm {0} m\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310528
    m_Localized: " \xB7 khay \u0111\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310529
    m_Localized: "Khay ch\u01B0a c\xF3 m\xF3n m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310530
    m_Localized: "{0} v\u1ECB kh\xE1ch gh\xE9 qua, ch\u01B0a ai ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310531
    m_Localized: "Kh\xF4ng c\xF3 kh\xE1ch gh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310532
    m_Localized: "{0} ng\u1EE7 say nh\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310533
    m_Localized: "Nh\u1EADn \xD72 \xB7 mi\u1EC5n ph\xED h\xF4m nay"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310534
    m_Localized: "Nh\u1EADn \xD72 \xB7 {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310535
    m_Localized: "C\xF2n thi\u1EBFu {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 340555564310536
    m_Localized: "\u0110\xE3 nh\u1EADn \xD72"
    m_Metadata:
      m_Items: []
  - m_Id: 360216427225088
    m_Localized: "Ng\xE0y {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 360216435613696
    m_Localized: "+{0} \xB7 qu\xE0 l\u1EDBn"
    m_Metadata:
      m_Items: []
  - m_Id: 360216435613697
    m_Localized: "Ng\xE0y 7 t\u1EB7ng th\xEAm {0} v\xE0 {1} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 360216435613698
    m_Localized: "Qu\xE0 l\u1EDBn: {0} \u0111\xE3 v\u1EC1 t\u1EE7 \u0111\u1ED3 \xB7 +{1} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 360216435613699
    m_Localized: "\u0110\xE3 c\xF3 {0} n\xEAn \u0111\u1ED5i th\xE0nh +{1} c\xE0 r\u1ED1t v\xE0ng \xB7 +{2} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 363105828724736
    m_Localized: "{0} c\u1EA3m \u01A1n v\xEC t\u1EA5m \u1EA3nh! +{1} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 363105845501952
    m_Localized: "Ch\u1EE5p 3 t\u1EA5m th\u1ECF xin \u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 366259223912448
    m_Localized: "\u0110ang ngh\u1EC9 \xB7 +{0}% v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 366259232301056
    m_Localized: "+{0}% v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 366259232301057
    m_Localized: "Ch\u1ED7 ngh\u1EC9 trong v\u01B0\u1EDDn: {0}/{1} b\xE9 \u0111ang ng\u1ED3i \xB7 +{2}% thu nh\u1EADp v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 366259232301058
    m_Localized: "Th\u1ECF \u0111ang ngh\u1EC9 ({0}) +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 366259232301059
    m_Localized: "\u0110\u1EE7 6 b\xE9 th\u1ECF c\xF9ng ngh\u1EC9"
    m_Metadata:
      m_Items: []
  - m_Id: 370712551350272
    m_Localized: "N\u01B0\u1EDBc v\u1EEBa s\xF4i, tr\xE0 s\u1EAFp th\u01A1m r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738880
    m_Localized: "Th\xEAm m\u1ED9t nh\xFAm l\xE1 n\u1EEFa l\xE0 v\u1EEBa."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738881
    m_Localized: "\u1EA4m n\xE0y pha cho c\u1EA3 v\u01B0\u1EDDn u\u1ED1ng \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738882
    m_Localized: "H\xEDt h\xE0\u2026 h\u01B0\u01A1ng tr\xE0 th\u01A1m gh\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738883
    m_Localized: "B\xE1nh s\u1EAFp ch\xEDn, ch\u1EDD m\xECnh ch\xFAt nha!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738884
    m_Localized: "Nh\xE0o b\u1ED9t m\u1ECFi tay m\xE0 vui gh\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738885
    m_Localized: "M\u1EBB n\xE0y ph\u1ED3ng \u0111\u1EC1u \u0111\u1EB9p qu\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738886
    m_Localized: "Ai mu\u1ED1n n\u1EBFm th\u1EED mi\u1EBFng \u0111\u1EA7u kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738887
    m_Localized: "H\xF4m nay l\xE1 non m\u1EC1m l\u1EAFm."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738888
    m_Localized: "Gi\u1ECF \u0111\u1EA7y r\u1ED3i, mang qua b\u1EBFp th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738889
    m_Localized: "H\xE1i nh\u1EB9 tay th\xEC c\xE2y m\u1EDBi vui."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738890
    m_Localized: "S\u01B0\u01A1ng c\xF2n \u0111\u1ECDng tr\xEAn l\xE1 n\xE8."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738891
    m_Localized: "Ng\xF4i sao kia v\u1EEBa nh\xE1y m\u1EAFt v\u1EDBi m\xECnh!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738892
    m_Localized: "M\xECnh \u0111\u1EBFm t\u1EDBi ng\xF4i sao th\u1EE9 m\u1ED9t tr\u0103m r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738893
    m_Localized: "\xC1nh tr\u0103ng soi r\xF5 c\u1EA3 v\u01B0\u1EDDn."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738894
    m_Localized: "\u1EE6 th\xEAm ch\xFAt \xE1nh sao cho ng\u1ECDt."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738895
    m_Localized: "V\u01B0\u1EDDn m\xECnh h\xF4m nay y\xEAn b\xECnh gh\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738896
    m_Localized: "L\xE1t n\u1EEFa u\u1ED1ng tr\xE0 v\u1EDBi m\xECnh nha!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738897
    m_Localized: "Gi\xF3 m\xE1t qu\xE1, mu\u1ED1n h\xE1t m\u1ED9t b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738898
    m_Localized: "C\xF3 b\u1EA1n gh\xE9 ch\u01A1i l\xE0 vui r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738899
    m_Localized: "Ho\xE0ng h\xF4n nhu\u1ED9m h\u1ED3ng c\u1EA3 v\u01B0\u1EDDn."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738900
    m_Localized: "S\u1EAFp t\u1EDBi gi\u1EDD th\u1EAFp \u0111\xE8n l\u1ED3ng r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738901
    m_Localized: "\u0110om \u0111\xF3m ra ch\u01A1i r\u1ED3i k\xECa!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738902
    m_Localized: "Khuya r\u1ED3i, u\u1ED1ng ch\xFAt tr\xE0 \u1EA5m nha."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738903
    m_Localized: "Ch\xE0o bu\u1ED5i s\xE1ng! S\u01B0\u01A1ng c\xF2n l\u1EA1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738904
    m_Localized: "M\u1EB7t tr\u1EDDi s\u1EAFp l\xF3, d\u1EADy th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738905
    m_Localized: "N\u1EAFng \u0111\u1EB9p qu\xE1, ph\u01A1i l\xE1 th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738906
    m_Localized: "Tr\u01B0a r\u1ED3i, ai \u0111\xF3i b\u1EE5ng ch\u01B0a?"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738907
    m_Localized: "Trung thu r\u1ED3i, \u0111i r\u01B0\u1EDBc \u0111\xE8n kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738908
    m_Localized: "Ch\xFAc m\u1EEBng n\u0103m m\u1EDBi! L\xEC x\xEC \u0111\xE2u n\xE8?"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738909
    m_Localized: "Gi\xE1ng sinh an l\xE0nh nha b\u1EA1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738910
    m_Localized: "Nh\u1EDD {0} ti\u1EBFp s\u1EE9c, m\u1EBB n\xE0y th\u01A1m h\u01A1n h\u1EB3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 370712559738911
    m_Localized: "H\xF4m nay m\xECnh di\u1EC7n \u0111\u1EB9p kh\xF4ng n\xE8?"
    m_Metadata:
      m_Items: []
  - m_Id: 375703374651392
    m_Localized: "B\u1ED9 {0} {1}/{2} \xB7 +{3}% khi \u0111\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817216
    m_Localized: "\u0110\u1EE7 b\u1ED9 {0} \xB7 tr\u1EA1m {0} +{1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817217
    m_Localized: "\u0110\u1EE7 b\u1ED9 {0} b\u1EADc {1}!"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817218
    m_Localized: "Tr\u1EA1m {0} thu th\xEAm {1}% m\xE3i m\xE3i"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817219
    m_Localized: "\u0110\xE3 g\u1EB7p {0} lo\xE0i th\u1ECF!"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817220
    m_Localized: "Qu\xE0 c\u1EE7a s\u1ED5 th\u1ECF: M\u0169 sao"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817221
    m_Localized: "\u0110\xE3 c\xF3 M\u0169 sao, nh\u1EADn {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817222
    m_Localized: "S\u1ED5 th\u1ECF \u0111\u01B0\u1EE3c vi\u1EC1n v\xE0ng \u0110\u1EE7 b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817223
    m_Localized: "\u0110\u1EE7 b\u1ED9 \xB7 \u0111\xE3 g\u1EB7p c\u1EA3 {0} lo\xE0i th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817224
    m_Localized: "G\u1EB7p 10 lo\xE0i th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817225
    m_Localized: "G\u1EB7p 20 lo\xE0i th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817226
    m_Localized: "G\u1EB7p 40 lo\xE0i th\u1ECF \xB7 t\u1EB7ng M\u0169 sao"
    m_Metadata:
      m_Items: []
  - m_Id: 375703399817227
    m_Localized: "G\u1EB7p \u0111\u1EE7 72 lo\xE0i \xB7 khung \u0110\u1EE7 b\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 378373560852480
    m_Localized: "Nh\u1EAFc t\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824000
    m_Localized: "V\u01B0\u1EDDn Tr\xE0 Th\u1ECF Tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824001
    m_Localized: "Khay \u0111\xE3 \u0111\u1EA7y v\xE0 c\xE1c b\xE9 th\u1ECF \u0111\xE3 ngh\u1EC9 \u0111\u1EE7, gh\xE9 v\u01B0\u1EDDn b\xE1n b\xE1nh nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824002
    m_Localized: "Qu\xE0 ng\xE0y m\u1EDBi \u0111ang ch\u1EDD, v\xE0 c\xF3 b\xE9 th\u1ECF m\u1EDBi gh\xE9 ti\u1EC7m."
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824003
    m_Localized: "M\xF9a {0} \u0111\xE3 v\u1EC1! Gh\xE9 v\u01B0\u1EDDn \u0111\xF3n b\u1EA1n m\u1EDBi nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824004
    m_Localized: "\u0110\xE3 l\xE2u kh\xF4ng th\u1EA5y b\u1EA1n, c\xE1c b\xE9 th\u1ECF nh\u1EDB b\u1EA1n l\u1EAFm."
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824005
    m_Localized: "Nh\u1EAFc nh\u1EDF"
    m_Metadata:
      m_Items: []
  - m_Id: 378373581824006
    m_Localized: "Khay \u0111\u1EA7y, qu\xE0 ng\xE0y, m\xF9a m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 384746075971584
    m_Localized: "M\u1EDF h\u0169 tr\u0103ng ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943104
    m_Localized: "Ch\u01B0a c\xF3 h\u0169 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943105
    m_Localized: "1 h\u0169 = 1 gi\u1EDD thu nh\u1EADp: +{0} \xB7 tr\xEAn k\u1EC7 {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943106
    m_Localized: "H\u0169 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943107
    m_Localized: "C\xF2n {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943108
    m_Localized: "K\u1EC7 \u0111\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943109
    m_Localized: "Mai mua ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943110
    m_Localized: "+1 h\u0169 tr\u0103ng \xB7 m\u1EDF \u1EDF v\xED c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 384746096943111
    m_Localized: "+1 h\u0169 tr\u0103ng (3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 386172349046784
    m_Localized: "Ti\u1EBFng tr\u1EA1m"
    m_Metadata:
      m_Items: []
  - m_Id: 386172357435392
    m_Localized: "Nh\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 386172357435393
    m_Localized: "T\u1EF1 \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 386172357435394
    m_Localized: "\u0110\xEAm tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 386172357435395
    m_Localized: "R\u1EA1ng s\xE1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 386172357435396
    m_Localized: "M\u01B0a"
    m_Metadata:
      m_Items: []
  - m_Id: 396779362181120
    m_Localized: "Nh\u1EADp m\xE3 qu\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569728
    m_Localized: "Nh\u1EADn qu\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569729
    m_Localized: "M\xE3 n\xE0y kh\xF4ng \u0111\xFAng, b\u1EA1n xem l\u1EA1i nh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569730
    m_Localized: "M\xE3 n\xE0y \u0111\xE3 h\u1EBFt h\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569731
    m_Localized: "V\u01B0\u1EDDn \u0111\xE3 nh\u1EADn qu\xE0 c\u1EE7a m\xE3 n\xE0y r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569732
    m_Localized: "Th\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569733
    m_Localized: "H\u1ED9p th\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569734
    m_Localized: "Ch\u01B0a c\xF3 th\u01B0 n\xE0o.\nQu\xE0 \u0111\u1EC1n b\xF9 v\xE0 qu\xE0 m\xF9a b\u1EA1n l\u1EE1 s\u1EBD \u0111\u1EBFn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569735
    m_Localized: "T\u1ED1i \u0111a {0} th\u01B0, m\u1ED7i th\u01B0 gi\u1EEF {1} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569736
    m_Localized: "Qu\xE0 xin l\u1ED7i: b\u1EA3n l\u01B0u c\u0169 kh\xF4ng \u0111\u1ECDc \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569737
    m_Localized: "Qu\xE0 m\xF9a {0} b\u1EA1n \u0111\xE3 l\u1EE1"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569738
    m_Localized: "+{0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569739
    m_Localized: "+{0} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569740
    m_Localized: "c\xF2n {0} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569741
    m_Localized: "h\xF4m nay l\xE0 ng\xE0y cu\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569742
    m_Localized: "Nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 396779370569743
    m_Localized: "\u0110\xE3 nh\u1EADn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 401557395857408
    m_Localized: "Xem 30 gi\xE2y \xB7 nh\u1EADn \xD72"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246016
    m_Localized: "Nh\u1EADn ngay \xD72"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246017
    m_Localized: "Xem 30 gi\xE2y \xB7 th\xEAm 1 l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246018
    m_Localized: "Nh\u1EADn ngay 1 l\u01B0\u1EE3t n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246019
    m_Localized: "Xem \u0111\u1EC3 nh\u1EADn 1 c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246020
    m_Localized: "Nh\u1EADn ngay 1 c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246021
    m_Localized: "+1 c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246022
    m_Localized: "\u0110ang m\u1EDF\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246023
    m_Localized: "Ch\u01B0a xem h\u1EBFt n\xEAn ch\u01B0a nh\u1EADn \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246024
    m_Localized: "B\u1ECF qu\u1EA3ng c\xE1o \xB7 30 ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246025
    m_Localized: "B\u1ECF qu\u1EA3ng c\xE1o \xB7 c\xF2n {0} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246026
    m_Localized: "\u0110\xE3 b\u1ECF qu\u1EA3ng c\xE1o, c\xF2n {0} ng\xE0y: m\u1ECDi n\xFAt xem th\xE0nh Nh\u1EADn ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 401557404246027
    m_Localized: "B\u1ECF qu\u1EA3ng c\xE1o {0} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 402840848687104
    m_Localized: "Th\u1ECF \u1EBEch"
    m_Metadata:
      m_Items: []
  - m_Id: 402840857075712
    m_Localized: "Th\u1ECF \u1EBEch gh\xE9 ch\u01A1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 402840857075713
    m_Localized: "Qu\xE0 m\u01B0a: {0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 402840857075714
    m_Localized: "Qu\xE0 m\u01B0a: {0} c\xE0 r\u1ED1t v\xE0 1 c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 402840857075715
    m_Localized: "G\u1EB7p Th\u1ECF \u1EBEch 5 l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 406865048494080
    m_Localized: "M\u1EDF r\u1ED9ng r\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 406865056882688
    m_Localized: "M\u1EDF r\u1ED9ng r\u1EEBng \xB7 v\xF2ng {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 406865056882689
    m_Localized: "R\u1EEBng l\xF9i ra m\u1ED9t v\xF2ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 408026325442560
    m_Localized: "B\u1ED1 tr\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831168
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831169
    m_Localized: "Gi\u1EEF \u0111\u1EC3 nh\u1EA5c l\xEAn \xB7 th\u1EA3 v\xE0o \xF4 tr\u1ED1ng, l\xEAn th\u1EE9 kh\xE1c \u0111\u1EC3 \u0111\u1ED5i ch\u1ED7, ho\u1EB7c v\xE0o kho"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831170
    m_Localized: "C\u1EA5t v\xE0o kho"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831171
    m_Localized: "\u0110ang c\u1EA5t: {0} tr\u1EA1m"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831172
    m_Localized: "\u0110\xE3 c\u1EA5t v\xE0o kho"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831173
    m_Localized: "Ch\u1EC9 c\u1EA5t \u0111\u01B0\u1EE3c tr\u1EA1m \u0111\xE3 m\u1EDF v\xE0 \u0111\u1ED3 trang tr\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831174
    m_Localized: "{0} \xB7 c\u1EA5p {1} \xB7 trong kho"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831175
    m_Localized: "L\u1EA5y ra"
    m_Metadata:
      m_Items: []
  - m_Id: 408026333831176
    m_Localized: "V\u01B0\u1EDDn \u0111\xE3 h\u1EBFt \xF4 tr\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 412723350331392
    m_Localized: "C\xE2u 50 con c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720000
    m_Localized: "M\u1ED9t b\xE9 th\u1ECF \u0111\u1EA1t 10 tim"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720001
    m_Localized: "C\xE1 b\u1EA1c nh\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720002
    m_Localized: "C\xE1 v\xE0ng cam"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720003
    m_Localized: "C\xE1 koi h\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720004
    m_Localized: "C\xE1 tr\u0103ng non"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720005
    m_Localized: "C\xE1 ch\xE9p v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720006
    m_Localized: "C\xE1 sao \u0111\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720007
    m_Localized: "+{0} \u0111i\u1EC3m th\xE2n thi\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720008
    m_Localized: "M\u1ED3i: {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720009
    m_Localized: "M\u1ED3i ti\u1EBFp theo sau {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720010
    m_Localized: "H\u1EBFt m\u1ED3i r\u1ED3i, ch\u1EDD ch\xFAt nh\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720011
    m_Localized: "B\xE9 {0} th\xE2n thi\u1EBFt \u0111\u1EE7 10 tim!"
    m_Metadata:
      m_Items: []
  - m_Id: 412723358720012
    m_Localized: "B\u1EA1n th\xE2n nh\u1EA5t \xB7 +{0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 416720798867456
    m_Localized: "V\u01B0\u1EDDn hoa sen"
    m_Metadata:
      m_Items: []
  - m_Id: 416720807256064
    m_Localized: "L\xF2 k\u1EB9o m\u1EA1ch nha"
    m_Metadata:
      m_Items: []
  - m_Id: 416720807256065
    m_Localized: "Ru\u1ED9ng l\xFAa n\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 416720807256066
    m_Localized: "Thuy\u1EC1n tr\xE0 \u0111\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 416720807256067
    m_Localized: "C\xF3 12 tr\u1EA1m \u0111ang ho\u1EA1t \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 416720807256068
    m_Localized: "C\xF3 16 tr\u1EA1m"
    m_Metadata:
      m_Items: []
  - m_Id: 416720807256069
    m_Localized: "C\u1EA7n v\u01B0\u1EDDn c\u1EA5p {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 427308916662272
    m_Localized: "C\xE2u c\xE1 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050880
    m_Localized: "C\xE2u c\xE1 \u1EDF ao tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050881
    m_Localized: "Th\u1EA3 c\xE2u"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050882
    m_Localized: "\u0110ang c\xE2u\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050883
    m_Localized: "H\u1EBFt m\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050884
    m_Localized: "Th\u1EA3 c\xE2u, ch\u1EDD phao ch\xECm r\u1ED3i ch\u1EA1m m\u1EB7t n\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050885
    m_Localized: "Ch\u1EDD phao ch\xECm nh\xE9\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050886
    m_Localized: "Phao ch\xECm r\u1ED3i! Ch\u1EA1m ngay!"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050887
    m_Localized: "S\u1EDBm qu\xE1, phao l\u1EA1i n\u1ED5i l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050888
    m_Localized: "M\u1EA5t m\u1ED3i r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050889
    m_Localized: "C\xE2u \u0111\u01B0\u1EE3c {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050890
    m_Localized: "Cho \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050891
    m_Localized: "{0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050892
    m_Localized: "+{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050893
    m_Localized: "Gi\u1ECF tr\u1ED1ng \xB7 c\xE2u \u1EDF ao"
    m_Metadata:
      m_Items: []
  - m_Id: 427308925050894
    m_Localized: "\u0110\xE3 \u0111\u1EE7 10 tim"
    m_Metadata:
      m_Items: []
  - m_Id: 672429948002304
    m_Localized: "M\u1EDF r\u1ED9ng v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 672429956390912
    m_Localized: "M\u1EDF r\u1ED9ng v\u01B0\u1EDDn \xB7 \u0111o\u1EA1n {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 672429956390913
    m_Localized: "S\u01B0\u01A1ng tan, v\u01B0\u1EDDn r\u1ED9ng th\xEAm!"
    m_Metadata:
      m_Items: []
  - m_Id: 672429956390914
    m_Localized: "V\u1EC1 ti\u1EC7m tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 749040500203520
    m_Localized: "C\u1EA7n c\u1EA5p v\u01B0\u1EDDn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 749040521175040
    m_Localized: "C\xF2n {0} b\xE9 th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 749040521175041
    m_Localized: "C\xF2n {0} lo\xE0i th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 749040521175042
    m_Localized: "C\xF2n {0} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 749040521175043
    m_Localized: "C\xF2n {0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 749040521175044
    m_Localized: "ch\u01A1i {0} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 770959844827136
    m_Localized: "N\xE2ng t\u1EA5t c\u1EA3 m\u1EDF \u1EDF c\u1EA5p v\u01B0\u1EDDn {0}. Gi\u1EDD c\u1EE9 n\xE2ng t\u1EEBng tr\u1EA1m nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 799467463761920
    m_Localized: "Ch\u1EC9 m\u1ED9t l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733440
    m_Localized: "G\xF3i ng\u01B0\u1EDDi m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733441
    m_Localized: "Qu\xE0 ch\xE0o ng\u01B0\u1EDDi l\xE0m v\u01B0\u1EDDn m\u1EDBi, mua \u0111\u01B0\u1EE3c m\u1ED9t l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733442
    m_Localized: "G\xF3i m\u1ED1c c\u1EA5p v\u01B0\u1EDDn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733443
    m_Localized: "M\u1EEBng v\u01B0\u1EDDn l\xEAn c\u1EA5p {0}, mua \u0111\u01B0\u1EE3c m\u1ED9t l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733444
    m_Localized: "C\xF2n {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733445
    m_Localized: "{0} \xB7 c\xF2n {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733446
    m_Localized: "G\xF3i n\xE0y \u0111\xE3 h\u1EBFt gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733447
    m_Localized: "\u0110\xE3 h\u1EBFt gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733448
    m_Localized: "{0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733449
    m_Localized: "{0} h\u0169 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733450
    m_Localized: "{0} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733451
    m_Localized: "M\u0169 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733452
    m_Localized: "1 th\u1ECF {0} ch\u01B0a g\u1EB7p"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733453
    m_Localized: "Mua \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733454
    m_Localized: "\u0110\u1EC3 sau"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733455
    m_Localized: "\u0110\xE3 nh\u1EADn g\xF3i. C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 \u1EE7ng h\u1ED9 v\u01B0\u1EDDn tr\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733456
    m_Localized: "C\u1EEDa h\xE0ng \u0111ang ch\u1EDD x\xE1c nh\u1EADn; g\xF3i s\u1EBD t\u1EF1 \u0111\u1EBFn khi xong"
    m_Metadata:
      m_Items: []
  - m_Id: 799467484733457
    m_Localized: "+{0} h\u0169 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 806681230434304
    m_Localized: "\u0110\xE3 mua"
    m_Metadata:
      m_Items: []
  - m_Id: 826590958182400
    m_Localized: "H\xF4m nay {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959616
    m_Localized: "Nh\u1EADn \u0111\u1EE7 nhi\u1EC7m v\u1EE5 ng\xE0y \u0111\u1EC3 m\u1EDF h\u1ED9p {0} qu\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959617
    m_Localized: "H\u1ED9p qu\xE0 \u0111\xE3 s\u1EB5n s\xE0ng \xB7 ch\u1EA1m \u0111\u1EC3 m\u1EDF"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959618
    m_Localized: "\u0110\xE3 m\u1EDF h\u1ED9p h\xF4m nay \xB7 mai c\xF3 h\u1ED9p m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959619
    m_Localized: "C\xF2n {0} nhi\u1EC7m v\u1EE5 ng\xE0y n\u1EEFa l\xE0 m\u1EDF h\u1ED9p"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959620
    m_Localized: "H\u1ED9p qu\xE0 h\xF4m nay"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959621
    m_Localized: "+{0} \u0111i\u1EC3m tu\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959622
    m_Localized: "Tu\u1EA7n n\xE0y \xB7 {0}/{1} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959623
    m_Localized: "M\u1ED7i nhi\u1EC7m v\u1EE5 ng\xE0y +{1}, h\u1ED9p qu\xE0 +{2} \xB7 c\xF2n {0} ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959624
    m_Localized: "R\u01B0\u01A1ng {0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959625
    m_Localized: "Qu\xE0 r\u01B0\u01A1ng tu\u1EA7n n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959626
    m_Localized: "{1} \xB7 c\u1EA7n {0} \u0111i\u1EC3m n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959627
    m_Localized: "\u0110\xE3 m\u1EDF r\u01B0\u01A1ng n\xE0y tu\u1EA7n n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959628
    m_Localized: "Tuy\u1EC7t!"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959629
    m_Localized: "{0} ph\xFAt thu nh\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959630
    m_Localized: "C\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959631
    m_Localized: "H\u0169 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959632
    m_Localized: "C\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959633
    m_Localized: "R\u01B0\u01A1ng {0} \u0111i\u1EC3m tu\u1EA7n tr\u01B0\u1EDBc ch\u01B0a m\u1EDF"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959634
    m_Localized: "+{0} h\u0169 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 826590974959635
    m_Localized: "+1 b\xE9 th\u1ECF {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 837451609268224
    m_Localized: "B\u1EA1n th\xEDch v\u01B0\u1EDDn tr\xE0 ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045440
    m_Localized: "Th\xEDch l\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045441
    m_Localized: "Ch\u01B0a l\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045442
    m_Localized: "V\u01B0\u1EDDn tr\xE0 n\xEAn l\xE0m g\xEC t\u1ED1t h\u01A1n?"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045443
    m_Localized: "M\u1ED9t d\xF2ng g\xF3p \xFD l\xE0 \u0111\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045444
    m_Localized: "G\u1EEDi t\u1EDBi email h\u1ED7 tr\u1EE3, k\xE8m m\xE3 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045445
    m_Localized: "G\u1EEDi"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045446
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045447
    m_Localized: "C\u1EA3m \u01A1n b\u1EA1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045448
    m_Localized: "\u2605 \u0110\xE1nh gi\xE1 game"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045449
    m_Localized: "G\xF3p \xFD v\u01B0\u1EDDn tr\xE0 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 837451626045450
    m_Localized: "{0}\n\nM\xE3 ng\u01B0\u1EDDi ch\u01A1i: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 844794350788608
    m_Localized: "Tu\u1EA7n \u0111\u1EA7u \xB7 ng\xE0y {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 844794363371520
    m_Localized: "Tu\u1EA7n \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 844794363371521
    m_Localized: "M\u1ED7i ng\xE0y m\u1EDF 4 vi\u1EC7c nh\u1ECF \xB7 qu\xE0 ch\u01B0a nh\u1EADn gi\u1EEF t\u1EDBi h\u1EBFt ng\xE0y {0}"
