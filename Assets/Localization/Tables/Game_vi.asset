      m_Items: []
  - m_Id: 195730810593285
    m_Localized: "M\xE9o"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593286
    m_Localized: "D\u1EBBo!"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593287
    m_Localized: "{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593288
    m_Localized: "Nh\u1ECBp {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593289
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593290
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593291
    m_Localized: "B\xE1nh xong!"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593292
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593293
    m_Localized: "{0} gi\xE3 c\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593294
    m_Localized: "Th\u1ECF B\u1EBFp b\xE1nh gi\xE3 c\xF9ng: \xD71,5"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593295
    m_Localized: "+1 c\u1ECF b\u1ED1n l\xE1 (l\u01B0\u1EE3t \u0111\u1EA7u trong ng\xE0y c\xF3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593296
    m_Localized: "+1 c\xE0 r\u1ED1t v\xE0ng (v\xE1n 3 sao \u0111\u1EA7u ng\xE0y)"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593297
    m_Localized: "Gi\xE3 b\xE1nh \xB7 c\xF2n {0} l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 195730810593298
    m_Localized: "Mai gi\xE3 ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 197531119116288
    m_Localized: "Th\u1ECF gh\xE9 ti\u1EC7m h\xF4m nay"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504896
    m_Localized: "{0} \xB7 {1} \xB7 c\xF2n {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504897
    m_Localized: "Lo\xE0i ch\u01B0a g\u1EB7p!"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504898
    m_Localized: "Mua \xB7 {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504899
    m_Localized: "C\xF2n thi\u1EBFu {0} c\xE0 r\u1ED1t v\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504900
    m_Localized: "\u0110\xE3 v\u1EC1 v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504901
    m_Localized: "{0} gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 197531127504902
    m_Localized: "{0} ph\xFAt"
    m_Metadata:
      m_Items: []
  - m_Id: 201923603980288
    m_Localized: "Ch\u1EEF to"
    m_Metadata:
      m_Items: []
  - m_Id: 208507595907072
    m_Localized: "H\xF4m nay v\u01B0\u1EDDn th\u01A1m qu\xE1, b\u1EA1n nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489984
    m_Localized: "Pha cho b\u1EA1n m\u1ED9t \u1EA5m tr\xE0 th\u1EADt ngon nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489985
    m_Localized: "M\u1EBB b\xE1nh n\xE0y d\xE0nh ri\xEAng cho b\u1EA1n \u0111\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489986
    m_Localized: "M\xECnh h\xE1i \u0111\u01B0\u1EE3c l\xE1 non ngon nh\u1EA5t r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489987
    m_Localized: "T\u1ED1i nay nhi\u1EC1u sao l\u1EAFm, ng\u1EAFm c\xF9ng m\xECnh kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489988
    m_Localized: "B\xE9 {0} t\u1EB7ng b\u1EA1n c\u1ECF b\u1ED1n l\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 208507608489989
    m_Localized: "Th\xE2n thi\u1EBFt h\u1EBFt m\u1EE9c \xB7 +{0} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 211753009930240
    m_Localized: "H\u1EE9ng l\xE1 tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513152
    m_Localized: "K\xE9o gi\u1ECF h\u1EE9ng l\xE1, n\xE9 qu\u1EA3 th\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513153
    m_Localized: "{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513154
    m_Localized: "C\xF2n {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513155
    m_Localized: +1
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513156
    m_Localized: "+2 l\xE1 v\xE0ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513157
    m_Localized: "Ui! \u22123"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513158
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513159
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513160
    m_Localized: "Gi\u1ECF \u0111\u1EA7y r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513161
    m_Localized: "H\u1EE9ng \u0111\u01B0\u1EE3c {0} l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513162
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513163
    m_Localized: "+1 c\u1ECF b\u1ED1n l\xE1 (l\u01B0\u1EE3t \u0111\u1EA7u trong ng\xE0y c\xF3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513164
    m_Localized: "H\u1EE9ng l\xE1 \xB7 c\xF2n {0} l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513165
    m_Localized: "Mai h\u1EE9ng ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513166
    m_Localized: "H\u1EE9ng l\xE1 3 sao l\u1EA7n \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 211753022513167
    m_Localized: "H\u1EE9ng l\xE1 30 v\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 212921664659456
    m_Localized: "Ch\u01B0a c\xF3 n\u01A1i l\u01B0u m\xE2y tr\xEAn b\u1EA3n n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436672
    m_Localized: "Ch\u01B0a l\u01B0u l\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436673
    m_Localized: "\u0110\xE3 l\u01B0u l\xEAn m\xE2y l\xFAc {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436674
    m_Localized: "Kh\xF4ng c\xF3 m\u1EA1ng, s\u1EBD l\u01B0u khi c\xF3 l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436675
    m_Localized: "B\u1EA3n tr\xEAn m\xE2y h\u1ECFng, \u0111\xE3 b\u1ECF qua"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436676
    m_Localized: "B\u1EA3n tr\xEAn m\xE2y t\u1EEB b\u1EA3n game m\u1EDBi h\u01A1n, \u0111\u1EC3 y\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436677
    m_Localized: "Hai b\u1EA3n kh\xE1c nhau, \u0111ang ch\u1EDD b\u1EA1n ch\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436678
    m_Localized: "L\u01B0u ngay"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436679
    m_Localized: "Kh\xF4i ph\u1EE5c t\u1EEB m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436680
    m_Localized: "Kh\xF4i ph\u1EE5c b\u1EA3n sao l\u01B0u tr\xEAn m\xE1y ({0})"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436681
    m_Localized: "\u0110\xE3 l\u1EA5y b\u1EA3n tr\xEAn m\xE2y; b\u1EA3n c\u0169 c\xF2n trong sao l\u01B0u tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436682
    m_Localized: "Gi\u1EEF b\u1EA3n tr\xEAn m\xE1y v\xE0 \u0111\xE3 l\u01B0u l\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436683
    m_Localized: "Tr\xEAn m\xE2y ch\u01B0a c\xF3 g\xEC"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436684
    m_Localized: "\u0110\xE3 l\u1EA5y l\u1EA1i b\u1EA3n sao l\u01B0u tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436685
    m_Localized: "Hai b\u1EA3n v\u01B0\u1EDDn kh\xE1c nhau"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436686
    m_Localized: "B\u1EA3n tr\xEAn m\xE2y ti\u1EBFn xa h\u01A1n. Ch\u1ECDn b\u1EA3n mu\u1ED1n gi\u1EEF; b\u1EA3n kia v\u1EABn \u0111\u01B0\u1EE3c sao l\u01B0u tr\xEAn m\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436687
    m_Localized: "B\u1EA3n tr\xEAn m\xE1y ti\u1EBFn xa h\u01A1n. Ch\u1ECDn b\u1EA3n mu\u1ED1n gi\u1EEF; b\u1EA3n kia v\u1EABn \u0111\u01B0\u1EE3c sao l\u01B0u tr\xEAn m\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436688
    m_Localized: "Tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436689
    m_Localized: "Tr\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436690
    m_Localized: "C\u1EA5p v\u01B0\u1EDDn {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436691
    m_Localized: "{0} b\xE9 th\u1ECF \xB7 {1} lo\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436692
    m_Localized: "\u0110\xE3 ch\u01A1i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436693
    m_Localized: "L\u1EA7n cu\u1ED1i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436694
    m_Localized: "G\u1EE3i \xFD"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436695
    m_Localized: "Gi\u1EEF b\u1EA3n tr\xEAn m\xE1y"
    m_Metadata:
      m_Items: []
  - m_Id: 212921681436696
    m_Localized: "L\u1EA5y b\u1EA3n tr\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 216545128079360
    m_Localized: "\u0110\xEAm \u0111om \u0111\xF3m"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439488
    m_Localized: "Ch\u1EA1m \u0111\u1EC3 b\u1EAFt \u0111om \u0111\xF3m bay qua v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439489
    m_Localized: "{0} \u0111i\u1EC3m"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439490
    m_Localized: "C\xF2n {0} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439491
    m_Localized: +1
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439492
    m_Localized: "+3 v\xE0ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439493
    m_Localized: "Th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439494
    m_Localized: Xong
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439495
    m_Localized: "L\u1ECD s\xE1ng r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439496
    m_Localized: "B\u1EAFt \u0111\u01B0\u1EE3c {0} con"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439497
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439498
    m_Localized: "+{0} c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439499
    m_Localized: "+1 c\xE0 r\u1ED1t v\xE0ng (3 sao)"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439500
    m_Localized: "\u0110\xE3 t\u1EDBi tr\u1EA7n h\xF4m nay, mai th\u01B0\u1EDFng ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439501
    m_Localized: "\u0110om \u0111\xF3m \xB7 c\xF2n {0} l\u01B0\u1EE3t"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439502
    m_Localized: "Mai b\u1EAFt ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439503
    m_Localized: "B\u1EAFt \u0111om \u0111\xF3m 3 sao l\u1EA7n \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 216545157439504
    m_Localized: "B\u1EAFt \u0111om \u0111\xF3m 30 \u0111\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 218048119169024
    m_Localized: "Kh\xE1ch \u0111\u1EB7t tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751936
    m_Localized: "Kh\xE1ch!"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751937
    m_Localized: "{0} gh\xE9 qu\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751938
    m_Localized: "Mu\u1ED1n mua"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751939
    m_Localized: "Ch\u1EDD th\xEAm {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751940
    m_Localized: "Giao \u0111\u1EE7: +{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751941
    m_Localized: "Giao \u0111\u1EE7: +{0} c\xE0 r\u1ED1t \xB7 +1 c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751942
    m_Localized: Giao
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751943
    m_Localized: "C\xF2n thi\u1EBFu {0} m\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751944
    m_Localized: "Kh\xE1ch h\xE0i l\xF2ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751945
    m_Localized: "+{0} c\xE0 r\u1ED1t"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751946
    m_Localized: "+{0} c\xE0 r\u1ED1t \xB7 +1 c\u1ECF b\u1ED1n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751947
    m_Localized: "Kh\xE1ch \u0111\xE3 \u0111i"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751948
    m_Localized: "Giao 2 \u0111\u01A1n tr\xE0 cho kh\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 218048131751949
    m_Localized: "Giao 20 \u0111\u01A1n tr\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 219281773027328
    m_Localized: "Tr\u1EA1m l\xEAn b\u1EADc {0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 219281785610240
    m_Localized: "{0} \xB7 c\u1EA5p {1}, gi\u1EDD thu g\u1EA5p \u0111\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 224994255691776
    m_Localized: "Ch\u1EC9 \u0111\u1EC3 \u0111\u1EB9p"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663296
    m_Localized: "N\xF3n l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663297
    m_Localized: "V\xF2ng hoa t\u01B0\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663298
    m_Localized: "M\u0169 len"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663299
    m_Localized: "N\u01A1 tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663300
    m_Localized: "M\u0169 sao"
    m_Metadata:
      m_Items: []
  - m_Id: 224994276663301
    m_Localized: "V\u01B0\u01A1ng mi\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857600
    m_Localized: "\u0110\u1ED3 cho th\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857601
    m_Localized: "M\u0169 ch\u1EC9 \u0111\u1EC3 \u0111\u1EB9p, \u0111\u1ED9i gi\u1EEFa hai tai \xB7 m\u1ED7i lo\u1EA1i m\u1ED9t chi\u1EBFc \xB7 nhu\u1ED9m l\xF4ng \u1EDF t\u1EA5m c\u1EE7a t\u1EEBng b\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857602
    m_Localized: "\u0110\xE3 c\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857603
    m_Localized: "Ch\u1EA1m l\u1EA7n n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857604
    m_Localized: "{0} \u0111\xE3 v\u1EC1 t\u1EE7 \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857605
    m_Localized: "Nhu\u1ED9m l\xF4ng \xB7 {0} c\xE0 r\u1ED1t v\xE0ng m\u1ED7i l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857606
    m_Localized: "Nhu\u1ED9m l\xF4ng \xB7 {0} c\xE0 r\u1ED1t v\xE0ng \xB7 C\xF2n thi\u1EBFu"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857607
    m_Localized: "G\u1ED9i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857608
    m_Localized: "\u0110\xE3 nhu\u1ED9m {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857609
    m_Localized: "h\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857610
    m_Localized: "\u0111\xE0o"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857611
    m_Localized: "v\xE0ng chanh"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857612
    m_Localized: "b\u1EA1c h\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857613
    m_Localized: "xanh tr\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857614
    m_Localized: "o\u1EA3i h\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857615
    m_Localized: kem
    m_Metadata:
      m_Items: []
  - m_Id: 224994280857616
    m_Localized: than
    m_Metadata:
      m_Items: []
  - m_Id: 249588253450240
    m_Localized: "Quy\u1EC1n ri\xEAng t\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838848
    m_Localized: "\u0110\u1ECDc ch\xEDnh s\xE1ch quy\u1EC1n ri\xEAng t\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838849
    m_Localized: "C\u1EA7n gi\xFAp? G\u1EEDi m\xE3 ng\u01B0\u1EDDi ch\u01A1i t\u1EDBi {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838850
    m_Localized: "Xo\xE1 d\u1EEF li\u1EC7u c\u1EE7a t\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838851
    m_Localized: "Ch\u1EA1m l\u1EA7n n\u1EEFa: xo\xE1 v\u01B0\u1EDDn, sao l\u01B0u v\xE0 b\u1EA3n tr\xEAn m\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838852
    m_Localized: "Kh\xF4ng ho\xE0n t\xE1c \u0111\u01B0\u1EE3c. Ch\u1EA1m l\u1EA7n cu\u1ED1i \u0111\u1EC3 xo\xE1 h\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838853
    m_Localized: "\u0110\xE3 xo\xE1 h\u1EBFt d\u1EEF li\u1EC7u; v\u01B0\u1EDDn b\u1EAFt \u0111\u1EA7u l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 249588261838854
    m_Localized: "\u0110\xE3 xo\xE1 tr\xEAn m\xE1y; b\u1EA3n tr\xEAn m\xE2y kh\xF4ng xo\xE1 \u0111\u01B0\u1EE3c, th\u1EED l\u1EA1i khi c\xF3 m\u1EA1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 251714404868096
    m_Localized: "Th\u1ECF \u0110\xE8n \xD4ng Sao"
    m_Metadata:
      m_Items: []
  - m_Id: 251714413256704
    m_Localized: "Th\u1ECF \xC1o D\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 251714413256705
    m_Localized: "Th\u1ECF Noel"
    m_Metadata:
      m_Items: []
  - m_Id: 252465726349312
    m_Localized: "G\u1EB7p Th\u1ECF \u0110\xE8n \xD4ng Sao"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320832
    m_Localized: "X\u1EBFp Th\u1ECF \u0110\xE8n \xD4ng Sao v\xE0o \u0111\xFAng ngh\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320833
    m_Localized: "Ch\u1EE5p \u1EA3nh c\xF3 Th\u1ECF \u0110\xE8n \xD4ng Sao"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320834
    m_Localized: "G\u1EB7p Th\u1ECF \xC1o D\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320835
    m_Localized: "X\u1EBFp Th\u1ECF \xC1o D\xE0i v\xE0o \u0111\xFAng ngh\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320836
    m_Localized: "Ch\u1EE5p \u1EA3nh c\xF3 Th\u1ECF \xC1o D\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320837
    m_Localized: "G\u1EB7p Th\u1ECF Noel"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320838
    m_Localized: "X\u1EBFp Th\u1ECF Noel v\xE0o \u0111\xFAng ngh\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320839
    m_Localized: "Ch\u1EE5p \u1EA3nh c\xF3 Th\u1ECF Noel"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320840
    m_Localized: Trung thu
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320841
    m_Localized: "T\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320842
    m_Localized: "Gi\xE1ng sinh"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320843
    m_Localized: "Th\u1ECF theo m\xF9a \xB7 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320844
    m_Localized: "Ch\u1EC9 c\xF3 trong {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 252465747320845
    m_Localized: "Ch\u1EC9 trong m\xF9a; h\u1EBFt m\xF9a th\xEC m\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 256349303726080
    m_Localized: "Trang tr\xED v\u01B0\u1EDDn"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891904
    m_Localized: "\u0110\xE3 c\xF3 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891905
    m_Localized: "H\u1EBFt ch\u1ED7"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891906
    m_Localized: "M\xE0u \u0111\xE8n l\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891907
    m_Localized: "\u0110\xE8n \u0111\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891908
    m_Localized: "B\u1ED3n hoa"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891909
    m_Localized: "Gh\u1EBF n\u1EA5m"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891910
    m_Localized: "Th\u1EA3m picnic"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891911
    m_Localized: "gi\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891912
    m_Localized: "h\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891913
    m_Localized: "b\u1EA1c h\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891914
    m_Localized: "o\u1EA3i h\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891915
    m_Localized: "Trang tr\xED ch\u1ED7 n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 256349328891916
    m_Localized: "\u0110\u1ED3 mua \u1EDF ti\u1EC7m tr\xE0, \u0111ang \u0111\u1EC3 trong kho"
    m_Metadata:
